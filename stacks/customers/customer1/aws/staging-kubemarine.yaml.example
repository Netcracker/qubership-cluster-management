import:
  - customers/customer1/aws/_defaults
  - catalog/aws/network
  - catalog/kubemarine/aws-vms
  - catalog/kubemarine/install
  - catalog/kubemarine/offline
  - catalog/helmfile/argocd
  - catalog/helmfile/istio
  - catalog/helmfile/kiali
  - catalog/helmfile/minio
  - catalog/helmfile/headlamp
vars:
  stage: staging-kubemarine
  local_endpoint: null
  environment: customer1-aws-staging-kubemarine
settings:
  local_lab: false
env:
  KUBECONFIG: ../../../.local-runtime/kubeconfig-customer1-aws-staging-kubemarine.yaml
components:
  terraform:
    network:
      vars:
        vpc_cidr: 10.50.0.0/16
        subnets:
          public: { cidr_block: 10.50.0.0/24, availability_zone: us-east-1a }
          a: { cidr_block: 10.50.1.0/24, availability_zone: us-east-1a, public: false }
          b: { cidr_block: 10.50.2.0/24, availability_zone: us-east-1b, public: false }
    vm-group:
      vars:
        ami_id: REPLACE_WITH_UBUNTU_24_04_AMI # Canonical, us-east-1
    jump-host:
      vars:
        allowed_cidrs: ["203.0.113.10/32"] # Replace with the operator public IP/CIDR.

# customer1-azure-staging on a real Azure subscription: Kubernetes by Kubemarine on VMs, isolated network, everything
# from Nexus. Step by step: docs/azure-vm-quickstart.md. Copy over staging.yaml (the Floci lab stack used by CI) only
# in your working copy; credentials go to secrets/customer1-azure-staging.yaml, never here.
import:
  - customers/customer1/azure/_defaults
  - catalog/azure/network
  - catalog/azure/vms
  - catalog/kubemarine
  - catalog/helmfile/argocd
  - catalog/helmfile/istio
  - catalog/helmfile/kiali
  - catalog/helmfile/minio
  - catalog/helmfile/headlamp
vars:
  stage: staging
  environment: customer1-azure-staging
env:
  KUBECONFIG: ../../../.local-runtime/kubeconfig-customer1-azure-staging.yaml
components:
  terraform:
    network:
      vars:
        vpc_cidr: 10.60.0.0/16
        subnets:
          public: { cidr_block: 10.60.0.0/24 }
          kubernetes: { cidr_block: 10.60.1.0/24, public: false }
    jump-host:
      vars:
        allowed_cidrs: ["0.0.0.0/0"] # SSH from anywhere (key-only); narrow to your IP for anything beyond a test bench

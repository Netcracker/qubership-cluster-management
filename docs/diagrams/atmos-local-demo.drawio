        <mxCell id="stack" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Final customer stack&lt;/b&gt;&lt;div style=&quot;font-size:19px;color:#52667C;margin-top:6px&quot;&gt;stacks/customers/customer1/aws/staging.yaml&lt;br&gt;Imports defaults and catalogs; overrides inputs,&lt;br&gt;workspace, application values, and kubeconfig&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=20;fontColor=#2563EB;fillColor=#EEF4FF;strokeColor=#2563EB;strokeWidth=1;" vertex="1" parent="1">

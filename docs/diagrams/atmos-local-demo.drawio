          <mxGeometry x="60" y="1050" width="1800" height="35" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;Delete resources successfully before Compose stop. KEEP_RUNNING_ON_SHUTDOWN preserves AKS during emulator restarts.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#52667C;" vertex="1" parent="1">

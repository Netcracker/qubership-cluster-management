        <mxCell id="start" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Start-AzureLocal.ps1&lt;/b&gt;&lt;div style=&quot;font-size:19px;color:#52667C;margin-top:6px&quot;&gt;local/compose.azure.yml -&amp;gt; Floci Azure API :4577&lt;br&gt;Pinned nightly digest; TLS CA trusted for current user&lt;br&gt;Docker socket lets the emulator create a k3s node.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=20;fontColor=#2563EB;fillColor=#EEF4FF;strokeColor=#2563EB;strokeWidth=1;" vertex="1" parent="1">

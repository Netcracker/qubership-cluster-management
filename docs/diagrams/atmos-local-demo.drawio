        </mxCell>
        <mxCell id="deploy" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Customer Azure workflow&lt;/b&gt;&lt;div style=&quot;font-size:19px;color:#52667C;margin-top:6px&quot;&gt;workflows/customers/customer1/azure.yaml&lt;br&gt;network -&amp;gt; kubernetes -&amp;gt; access -&amp;gt; istio -&amp;gt; argocd&lt;br&gt;-&amp;gt; kiali -&amp;gt; minio -&amp;gt; headlamp -&amp;gt; load-balancer&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=20;fontColor=#2563EB;fillColor=#EEF4FF;strokeColor=#2563EB;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="175" width="840" height="135" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Prepare-AzureCluster.ps1&lt;/b&gt;&lt;div style=&quot;font-size:19px;color:#52667C;margin-top:6px&quot;&gt;Read selected Atmos configuration -&amp;gt; request admin kubeconfig&lt;br&gt;Resolve published API port from the matching Docker container&lt;br&gt;Write .local-runtime/kubeconfig-customer1-azure-staging.yaml&lt;br&gt;Wait for Ready node and CoreDNS; current API port: 6600.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=20;fontColor=#008778;fillColor=#EAF8F4;strokeColor=#008778;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="1800" height="155" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Browser / Windows&lt;/b&gt;&lt;div style=&quot;font-size:19px;color:#52667C;margin-top:6px&quot;&gt;Argo CD: localhost:18080&lt;br&gt;Kiali: localhost:18081&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=20;fontColor=#52667C;fillColor=#F3F6FA;strokeColor=#52667C;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="625" width="450" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pf" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;kubectl port-forward&lt;/b&gt;&lt;div style=&quot;font-size:18px;color:#52667C;margin-top:6px&quot;&gt;Argo CD svc/argocd-server 18080:80&lt;br&gt;Kiali svc/kiali 18081:20001&lt;br&gt;Run each command in its own terminal.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=19;fontColor=#008778;fillColor=#EAF8F4;strokeColor=#008778;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="615" width="610" height="135" as="geometry" />
        </mxCell>
        <mxCell id="pods" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Real Kubernetes workloads&lt;/b&gt;&lt;div style=&quot;font-size:18px;color:#52667C;margin-top:6px&quot;&gt;API -&amp;gt; Service-selected Pod&lt;br&gt;Argo CD and Kiali returned HTTP 200.&lt;br&gt;Istio, MinIO, Headlamp also deployed.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=19;fontColor=#008778;fillColor=#EAF8F4;strokeColor=#008778;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="615" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="lb" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Azure load-balancer: API resources only&lt;/b&gt;&lt;div style=&quot;font-size:18px;color:#52667C;margin-top:6px&quot;&gt;Public IP + LB + backend pool/address + probe + TCP rule&lt;br&gt;Rule: frontend :80 -&amp;gt; Kiali NodePort :30081&lt;br&gt;Backend IP is recorded in the stack; recheck after recreation.&lt;br&gt;No packet forwarding is implemented by this Floci service.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=19;fontColor=#AD6200;fillColor=#FFF5E6;strokeColor=#AD6200;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="825" width="900" height="175" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Current emulator constraints&lt;/b&gt;&lt;div style=&quot;font-size:18px;color:#52667C;margin-top:6px&quot;&gt;AKS read-back omits properties: repeat plans may replace it.&lt;br&gt;Review plans before repeating Kubernetes apply.&lt;br&gt;Local subnet RBAC assignment is disabled in this stack.&lt;br&gt;The real-Azure module defaults still enable the assignment.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=19;fontColor=#AD6200;fillColor=#FFF5E6;strokeColor=#AD6200;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="825" width="840" height="175" as="geometry" />

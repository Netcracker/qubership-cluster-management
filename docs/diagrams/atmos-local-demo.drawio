        <mxCell id="tf" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Terraform implementation&lt;/b&gt;&lt;div style=&quot;font-size:18px;color:#52667C;margin-top:6px&quot;&gt;components/terraform/aws/network/&lt;br&gt;*.tf files in one directory form one root module.&lt;br&gt;A separate workspace holds each stack state.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=19;fontColor=#2563EB;fillColor=#EEF4FF;strokeColor=#2563EB;strokeWidth=1;" vertex="1" parent="1">

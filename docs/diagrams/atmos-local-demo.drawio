        <mxCell id="helm" value="&lt;div style=&quot;font-family:Segoe UI;line-height:1.28&quot;&gt;&lt;b&gt;Shared Helmfile implementation&lt;/b&gt;&lt;div style=&quot;font-size:18px;color:#52667C;margin-top:6px&quot;&gt;components/helmfile/argocd/helmfile.yaml.gotmpl&lt;br&gt;Adjacent values.yaml.gotmpl serializes .Values.values&lt;br&gt;Catalog values + stack overrides -&amp;gt; chart values&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fontFamily=Segoe UI;fontSize=19;fontColor=#008778;fillColor=#EAF8F4;strokeColor=#008778;strokeWidth=1;" vertex="1" parent="1">

repositories:
  - name: headlamp
    url: {{ .Values | get "nexus_charts" .Values.chart_repository }}
helmDefaults:
  wait: true
  timeout: 600
releases:
  - name: headlamp
    namespace: headlamp
    createNamespace: true
    chart: headlamp/headlamp
    version: {{ .Values.chart_version | quote }}
    values:
      - values.yaml.gotmpl

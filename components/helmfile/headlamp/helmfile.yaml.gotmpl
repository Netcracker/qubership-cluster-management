repositories:
  - name: headlamp
    url: https://kubernetes-sigs.github.io/headlamp/
helmDefaults:
  wait: true
  timeout: 600
releases:
  - name: headlamp
    namespace: headlamp
    createNamespace: true
    chart: headlamp/headlamp
    version: {{ .Values.chart_version | quote }}
    values:
      - values.yaml.gotmpl

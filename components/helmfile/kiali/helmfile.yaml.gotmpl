repositories:
  - name: kiali
    url: {{ .Values | get "nexus_charts" .Values.chart_repository }}
helmDefaults:
  wait: true
  timeout: 600
releases:
  - name: kiali-operator
    namespace: kiali-operator
    createNamespace: true
    chart: kiali/kiali-operator
    version: {{ .Values.chart_version | quote }}
    disableValidationOnInstall: true
    values:
      - values.yaml.gotmpl
